{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JialiNong/europe-route-finder-skill/europe-route-finder/schema/trip.schema.json",
  "title": "路线对比页数据",
  "description": "europe-route-finder 输出的行程数据。方案编号由 routes 的顺序自动生成 A、B、C…；标注 html 的字段允许 <b> <a> <br> 等行内标签。",
  "type": "object",
  "required": [
    "title",
    "origin",
    "destination",
    "queriedAt",
    "routes"
  ],
  "properties": {
    "lang": {
      "enum": [
        "zh",
        "en"
      ],
      "description": "Language shown first. 默认显示的语言。"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "zh",
          "en"
        ]
      },
      "description": "Languages the content is written in; the page shows a switch when there are two. 内容包含的语言，两种时页面显示切换按钮。"
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "页面标题，两到四个词，例如「莱比锡到维也纳路线」"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "版本号，每次改版加 1"
    },
    "origin": {
      "$ref": "#/$defs/text"
    },
    "destination": {
      "$ref": "#/$defs/text"
    },
    "dateLabel": {
      "$ref": "#/$defs/text",
      "description": "例如「11 月 26–28 日」"
    },
    "eyebrow": {
      "$ref": "#/$defs/text",
      "description": "可选，覆盖页头小字"
    },
    "heading": {
      "$ref": "#/$defs/text",
      "description": "可选，覆盖大标题"
    },
    "queriedAt": {
      "$ref": "#/$defs/text",
      "description": "查询时间，例如「2026 年 10 月 23 日傍晚（柏林时间）」"
    },
    "intro": {
      "$ref": "#/$defs/text",
      "description": "html：目标、硬性条件、关键思路"
    },
    "verdict": {
      "type": "object",
      "properties": {
        "items": {
          "$ref": "#/$defs/texts",
          "description": "html：顶部结论，每条一般以「<b>X · 方案名，约 N€。</b>」开头"
        },
        "alert": {
          "$ref": "#/$defs/text",
          "description": "html：提示框"
        },
        "alerts": {
          "$ref": "#/$defs/texts"
        }
      },
      "additionalProperties": false
    },
    "relax": {
      "$ref": "#/$defs/texts",
      "description": "html：放宽条件能省多少"
    },
    "dates": {
      "$ref": "#/$defs/texts",
      "description": "日期列，例如 [\"周四 11/26\", \"周五 11/27\"]；只有一天时不显示日期表"
    },
    "dateTableTitle": {
      "$ref": "#/$defs/text"
    },
    "dateTableNote": {
      "$ref": "#/$defs/text",
      "description": "html"
    },
    "overviewTitle": {
      "$ref": "#/$defs/text"
    },
    "overviewNote": {
      "$ref": "#/$defs/text",
      "description": "html"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "description": "按推荐顺序排列",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "caption": {
            "$ref": "#/$defs/text"
          },
          "items": {
            "$ref": "#/$defs/texts"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "caption": {
                  "$ref": "#/$defs/text",
                  "description": "html"
                },
                "items": {
                  "$ref": "#/$defs/texts",
                  "description": "html"
                }
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "why"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "why": {
            "$ref": "#/$defs/text",
            "description": "html"
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "paragraphs": {
          "$ref": "#/$defs/texts",
          "description": "html：假设、查法、来源、没查的来源"
        },
        "links": {
          "type": "array",
          "description": "每一行是一组链接",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/link"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "text",
        "url"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "name",
        "total"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text",
          "description": "卡片标题"
        },
        "short": {
          "$ref": "#/$defs/text",
          "description": "表格里的短名"
        },
        "tag": {
          "$ref": "#/$defs/text",
          "description": "小标签，例如「最便宜」「已订」"
        },
        "total": {
          "$ref": "#/$defs/text",
          "description": "卡片总价，可以是区间，例如「20.49–23.49€」"
        },
        "price": {
          "$ref": "#/$defs/text",
          "description": "总览表里的价格，默认用 total"
        },
        "totalLabel": {
          "$ref": "#/$defs/text",
          "description": "合计行文字，默认「合计」"
        },
        "effort": {
          "enum": [
            "green",
            "blue",
            "red"
          ],
          "description": "green 省事、blue 中等、red 折腾"
        },
        "transfers": {
          "$ref": "#/$defs/text",
          "description": "例如「2 次」"
        },
        "times": {
          "$ref": "#/$defs/text",
          "description": "例如「07:00 → 15:45」"
        },
        "stay": {
          "$ref": "#/$defs/text",
          "description": "过夜城市和房型；任何一条有 stay 才显示「过夜」列"
        },
        "backup": {
          "$ref": "#/$defs/text"
        },
        "datePrices": {
          "$ref": "#/$defs/texts",
          "description": "和 dates 一一对应，查不到写 \"—\""
        },
        "summary": {
          "$ref": "#/$defs/text",
          "description": "html，简单方案只写一段话时用"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t"
            ],
            "properties": {
              "t": {
                "$ref": "#/$defs/text",
                "description": "时间和起止站，例如「07:00 Leipzig Hbf → 08:34 Dresden Hbf」"
              },
              "what": {
                "$ref": "#/$defs/text",
                "description": "html：车次、运营方、换乘时间"
              },
              "stay": {
                "type": "boolean",
                "description": "住宿或卧铺这一段设为 true"
              }
            }
          }
        },
        "buy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "price"
            ],
            "properties": {
              "item": {
                "$ref": "#/$defs/text"
              },
              "where": {
                "$ref": "#/$defs/text",
                "description": "html：购买链接和其他渠道的对比价"
              },
              "price": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "notes": {
          "$ref": "#/$defs/texts",
          "description": "html：后备、风险、好处和代价"
        }
      }
    },
    "text": {
      "description": "Text, or the same text in both languages: {\"zh\": \"…\", \"en\": \"…\"}. 文本，或者中英双语对象。",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "zh": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "texts": {
      "description": "A list of texts, or one list per language. 文本数组，或者每种语言一个数组。",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        {
          "type": "object",
          "properties": {
            "zh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    }
  }
}
